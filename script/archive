#!/bin/bash
# Archives a release build from a vX.Y.Z tag, numbering the build
# MAJOR*10000 + MINOR*100 + PATCH (v1.2.3 is build 10203).
#
#   script/archive                  # HEAD must be at a vX.Y.Z tag
#   script/archive v1.2.3 [build] [archive-path] [configuration]
#
# Needs Config/Signing.xcconfig with your DEVELOPMENT_TEAM. With ASC_KEY_ID,
# ASC_ISSUER_ID and ASC_KEY_PATH set (script/upload sets them), Xcode fetches
# profiles with that App Store Connect API key instead of its Accounts.
#
# Over SSH the login keychain is locked, so codesign can't use the signing
# identity in it. When BUILD_KEYCHAIN (~/Library/Keychains/chatwithwork-build.keychain-db)
# and its password file BUILD_KEYCHAIN_PASSWORD_FILE
# (~/.appstoreconnect/build-signing/keychain-password) exist, the archive is
# signed from that keychain instead (docs/app-store.md, "Signing without Xcode's Accounts").
set -euo pipefail
cd "$(dirname "$0")/.."

tag="${1:-$(git describe --tags --exact-match 2>/dev/null || true)}"
version="${tag#v}"
if [[ ! "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  echo "Give a stable tag like v1.2.3 (HEAD isn't at one)." >&2
  exit 1
fi

build="${2:-$((BASH_REMATCH[1] * 10000 + BASH_REMATCH[2] * 100 + BASH_REMATCH[3]))}"
archive="${3:-build/ChatWithWork-$version.xcarchive}"
configuration="${4:-Release}"

auth=()
if [ -n "${ASC_KEY_ID:-}" ] && [ -n "${ASC_ISSUER_ID:-}" ] && [ -n "${ASC_KEY_PATH:-}" ]; then
  auth=(-allowProvisioningUpdates
    -authenticationKeyPath "$ASC_KEY_PATH"
    -authenticationKeyID "$ASC_KEY_ID"
    -authenticationKeyIssuerID "$ASC_ISSUER_ID")
fi

keychain="${BUILD_KEYCHAIN:-$HOME/Library/Keychains/chatwithwork-build.keychain-db}"
password_file="${BUILD_KEYCHAIN_PASSWORD_FILE:-$HOME/.appstoreconnect/build-signing/keychain-password}"
if [ -f "$keychain" ] && [ -f "$password_file" ]; then
  security unlock-keychain -p "$(cat "$password_file")" "$keychain"
  auth+=(OTHER_CODE_SIGN_FLAGS="--keychain $keychain")
fi

xcodebuild archive \
  -project ChatWithWork.xcodeproj \
  -scheme ChatWithWork \
  -configuration "$configuration" \
  -destination "generic/platform=iOS" \
  -archivePath "$archive" \
  MARKETING_VERSION="$version" \
  CURRENT_PROJECT_VERSION="$build" \
  ${auth[@]+"${auth[@]}"}

echo "Archived $version ($build) to $archive"
