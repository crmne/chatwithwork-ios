// Shared by every configuration. Values that differ per environment live in
// Debug.xcconfig, Staging.xcconfig, and Release.xcconfig.
//
// xcconfig treats "//" as the start of a comment, so URLs are written as
// https:/$()/host: the empty $() keeps the second slash.

PRODUCT_NAME = ChatWithWork
CWW_BUNDLE_IDENTIFIER_BASE = com.chatwithwork.app
PRODUCT_BUNDLE_IDENTIFIER = $(CWW_BUNDLE_IDENTIFIER_BASE)$(CWW_BUNDLE_IDENTIFIER_SUFFIX)

// The version main is working towards: Xcode Cloud's TestFlight builds of
// main carry it, so bump it once a version goes to App Review. Builds from a
// vX.Y.Z tag (script/archive, or Xcode Cloud started from a tag) take the
// tag's version instead (see README, Releasing).
MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// The custom scheme ASWebAuthenticationSession listens for when the server
// hands a sign-in or a connector back to the app.
CWW_CALLBACK_SCHEME = chatwithwork

// The app group the share extension hands shared files through. Each
// build's own: group.com.chatwithwork.app, .staging and .debug.
CWW_APP_GROUP = group.$(CWW_BUNDLE_IDENTIFIER_BASE)$(CWW_BUNDLE_IDENTIFIER_SUFFIX)

CODE_SIGN_STYLE = Automatic

// Signing.xcconfig is git-ignored: it holds DEVELOPMENT_TEAM and anything
// else that identifies an Apple account. Copy Signing.xcconfig.example.
#include? "Signing.xcconfig"
